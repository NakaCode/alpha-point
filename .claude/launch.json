{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "canal-estatico",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "linha-do-tempo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "ferramentas/linha-do-tempo.mjs",
        "servir",
        "juneau",
        "--porta=8790"
      ],
      "port": 8790
    },
    {
      "name": "linha-do-tempo-la",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "ferramentas/linha-do-tempo.mjs",
        "servir",
        "los-angeles",
        "--porta=8790"
      ],
      "port": 8790
    },
    {
      "name": "linha-do-tempo-zona",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "ferramentas/linha-do-tempo.mjs",
        "servir",
        "zona-do-canal",
        "--porta=8790"
      ],
      "port": 8790
    }
  ]
}