# O que NUNCA entra no git.
# (o resto entra: seu trabalho não deve depender de você lembrar de liberá-lo)

# Segredo — nunca, em hipótese alguma
.env
.env.*
*.pem
*.key
*.pfx
*_credentials.json
service-account*.json

# O banco: é estado local, e binário. Sincronizar corrompe.
db/

# O bruto: pesado demais, e não viaja. Só as entregas sobem.
midia/

# A produção: o TEXTO entra (pauta, roteiro, críticas, espelho, cenas HTML, planos, o XML);
# o binário pesado não — áudio, vídeo, mídia baixada e quadros. Eles se refazem ou se baixam de
# novo, e um repositório com gigabytes de mp4 deixa de clonar.
# (Bloco copiado do .gitignore que a pré-v1 da Régie escreve, bin/create-regie, em 25/09/2026:
# o "regie atualizar" não traz .gitignore, e as ferramentas da pré-v1 gravam em out/<vídeo>/.)
out/**/*.wav
out/**/*.mp3
out/**/*.mp4
out/**/*.mov
out/**/*.webm
out/*/_media/
out/*/_narracao/
out/*/_quadros/
acervo/trilha/*.mp3
acervo/trilha/*.wav
marca/pecas/*.mov
# Quadros PNG de conferência (4K pesa megas cada): a pré-v1 não ignora, o canal sim.
out/**/*.png
# Rascunho dos portões dos especialistas: o /tmp dos ofícios vira out/<proj>/_tmp/ (CLAUDE.md, "Os especialistas").
out/*/_tmp/
out/_tmp/

# Cópias de trabalho do git autônomo e configuração local do Claude (nunca vão para o repositório)
.claude/worktrees/
.claude/settings.local.json

# Travas e reservas de processo (nunca estado do canal)
*.trava
*.trava.tomada
*.lock
out/**/*.reserva
# A cópia que o `qc-fusao-espelho --aplicar` deixa antes de gravar a fusão: a versão de antes já está no git.
out/*/espelho.json.bkp-*

# Lixo de máquina
node_modules/
.DS_Store
Thumbs.db
*.log
__pycache__/

# As propostas de logo (marca §8): as checagens têm quadros do vídeo com satélite e footage licenciados.
marca/logo/propostas/
marca/logo/propostas-2/
marca/cta/propostas/

# A coleta das dimensões do dossiê (pautas/<proj>/_dimensoes/): tem passagens longas de imprensa e de livros. Sobe só o
# fundamento.json, o fundamento.md e o verificacao.json (como no Juneau).
pautas/*/_dimensoes/

# clipes aposentados por rename (o .mp4 com sufixo escapa do *.mp4)
*.mp4.aposentado-*

# PDFs e textos de fonte baixados pelas pesquisas de pauta (pesados; ficam só nesta máquina)
out/_pautas/*/_fontes/

# Avisos de ocupado entre a Sala de controle e os setores (setores/REGIMENTO.md, "A máquina e os arquivos únicos").
out/_maquina/

# O ZIP do ilustrador e as conferências dele (out/_compartilhar/ilustrador/): o montar-zip.py e o LEIA-ANTES.md vão ao git.
out/_compartilhar/**/*.zip
out/_compartilhar/**/_conferencia/
