   "diff": {
    "blocos": [
     {
      "n": 1,
      "parte": "p1",
      "sai": [
       {
        "frase": "There, Loreto, Peru's largest department, is also one of its most thinly populated.",
        "itens": [
         "F01"
        ]
       }
      ],
      "entra": [
       {
        "frase": "There, Loreto, Peru's largest region, is also one of its most thinly populated.",
        "itens": [
         "F01"
        ]
       }
      ]
     },
     {
      "n": 2,
      "parte": "p1",
      "sai": [
       {
        "frase": "Peru's own water authority calls that a paradox.",
        "itens": [
         "F02"
        ]
       }
      ],
      "entra": [
       {
        "frase": "The country's water authority calls that imbalance a paradox.",
        "itens": [
         "F02"
        ]
       }
      ]
     },
     {
      "n": 3,
      "parte": "p2",
      "sai": [
       {
        "frase": "It stays as fog, low cloud and drizzle, not rain.",
        "itens": [
         "F03"
        ]
       }
      ],
      "entra": [
       {
        "frase": "It stays as fog, low cloud and drizzle.",
        "itens": [
         "F03"
        ]
       }
      ]
     },
     {
      "n": 4,
      "parte": "p2",
      "sai": [
       {
        "frase": "On the eastern slopes, that air rises and falls as rain.",
        "itens": [
         "F04"
        ]
       }
      ],
      "entra": [
       {
        "frase": "On the eastern slopes, that air rises, and its moisture falls as rain.",
        "itens": [
         "F04"
        ]
       }
      ]
     },
     {
      "n": 5,
      "parte": "p2",
      "sai": [
       {
        "frase": "That summer rain runs off fast, down short rivers.",
        "itens": [
         "F05"
        ]
       }
      ],
      "entra": [
       {
        "frase": "That rain runs off fast, down short rivers.",
        "itens": [
         "F05"
        ]
       }
      ]
     },
     {
      "n": 6,
      "parte": "p2",
      "sai": [
       {
        "frase": "In 2009, Peru's water authority said that about half of the flood water from the wetter part of the Pacific side runs back into the sea unused, for lack of storage.",
        "itens": [
         "F06"
        ]
       }
      ],
      "entra": [
       {
        "frase": "In 2009, Peru's water authority said that, for lack of storage, about half of the flood water from the wetter part of the Pacific side runs back into the sea unused.",
        "itens": [
         "F06"
        ]
       }
      ]
     },
     {
      "n": 7,
      "parte": "p3",
      "sai": [
       {
        "frase": "It did not put most of its people on the coast.",
        "itens": [
         "F07"
        ]
       }
      ],
      "entra": [
       {
        "frase": "It did not put most of the country's people on the coast.",
        "itens": [
         "F07"
        ]
       }
      ]
     },
     {
      "n": 8,
      "parte": "p4",
      "sai": [
       {
        "frase": "By 2025, nearly six in ten did.",
        "itens": [
         "F08"
        ]
       }
      ],
      "entra": [
       {
        "frase": "By 2025, nearly six in ten lived in that coastal region.",
        "itens": [
         "F08"
        ]
       }
      ]
     },
     {
      "n": 9,
      "parte": "p4",
      "sai": [
       {
        "frase": "Lima and Callao grew from about 650,000 people in 1940 to more than ten and a half million in 2025, from about one in ten Peruvians to about a third.",
        "itens": [
         "F09"
        ]
       }
      ],
      "entra": [
       {
        "frase": "In 1940, Lima and Callao had about 650,000 people, about one in ten Peruvians.",
        "itens": [
         "F09"
        ]
       },
       {
        "frase": "By 2025, they had more than ten and a half million, about a third.",
        "itens": [
         "F09"
        ]
       }
      ]
     },
     {
      "n": 10,
      "parte": "p4",
      "sai": [
       {
        "frase": "In 1971, 180 families took over a plot of land, and more followed.",
        "itens": [
         "F10"
        ]
       },
       {
        "frase": "The government set out to resettle about 7,000 families on a vast, semi-desert stretch of sand south of the city.",
        "itens": [
         "F10"
        ]
       }
      ],
      "entra": [
       {
        "frase": "In 1971, a group of 180 families took over a plot of land, and more followed.",
        "itens": [
         "F10"
        ]
       },
       {
        "frase": "The government then set out to resettle about 7,000 families on a vast, semi-desert stretch of sand south of the city.",
        "itens": [
         "F10"
        ]
       }
      ]
     },
     {
      "n": 11,
      "parte": "p5",
      "sai": [
       {
        "frase": "Peru's weather service says it was built first to power a hydroelectric plant, and also to firm up the river Lima drinks from.",
        "itens": [
         "F11"
        ]
       },
       {
        "frase": "The plant, at Huinco, opened in 1964.",
        "itens": [
         "F12"
        ]
       }
      ],
      "entra": [
       {
        "frase": "Peru's weather service says it was built first to power a hydroelectric plant, and also to steady the flow of the river Lima drinks from.",
        "itens": [
         "F11"
        ]
       },
       {
        "frase": "The power plant, at Huinco, opened in 1964.",
        "itens": [
         "F12"
        ]
       }
      ]
     },
     {
      "n": 12,
      "parte": "p5",
      "sai": [
       {
        "frase": "In remarks reported in 2024, Rómulo Cárhuaz, a watershed analyst at the utility, told its press office that the releases run from May 1 to November 30.",
        "itens": [
         "F13"
        ]
       }
      ],
      "entra": [
       {
        "frase": "The releases run from May 1 to November 30, Rómulo Cárhuaz, a watershed analyst at the utility, told its press office in remarks reported in 2024.",
        "itens": [
         "F13"
        ]
       }
      ]
     },
     {
      "n": 13,
      "parte": "p6",
      "sai": [
       {
        "frase": "In the districts it studied, almost all of those homes bought water from tanker trucks, at about six times what connected homes pay.",
        "itens": [
         "F14"
        ]
       },
       {
        "frase": "In San Juan de Miraflores, in southern Lima, Catalina Naupa, 59, told AFP in March 2025 that her water comes by truck.",
        "itens": [
         "F15"
        ]
       },
       {
        "frase": "\"There are worms in the bottom of the tank,\" she said.",
        "itens": [
         "F16"
        ]
       },
       {
        "frase": "She said she washed clothes once a week, or every two weeks, to save water.",
        "itens": [
         "F16"
        ]
       },
       {
        "frase": "An official at the utility told the agency it brings about 260 gallons of water a week to each family in the parts of the district without pipes.",
        "itens": [
         "F17"
        ]
       },
       {
        "frase": "AFP reported that those deliveries were free.",
        "itens": [
         "F18"
        ]
       }
      ],
      "entra": [
       {
        "frase": "In the districts it studied, almost all of the homes without a connection bought water from tanker trucks, at about six times what connected homes pay.",
        "itens": [
         "F14"
